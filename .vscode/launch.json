    "version": "0.2.0",
    "configurations": [
        {
        "name": "PeoplePro",
        "request": "launch",
        "type": "dart",
        "program": "lib/main.dart",
        "preLaunchTask": "adb reverse 44390",
        "toolArgs": [
            "--dart-define=HIVE_API_URL=https://localhost:44390/api/v1",
            "--android-skip-build-dependency-validation"
        ]
        },


        // {
        //     "name": "PeoplePro",
